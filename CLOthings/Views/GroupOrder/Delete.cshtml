@model CLOthings.Models.GroupOrder

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<div class="alert alert-warning" role="alert">
    <strong>Warning!</strong> Are you sure you want to delete this?
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">GroupOrder (#@Model.GroupOrderId)</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.GroupOrderId)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.GroupOrderId)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.UserId)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.UserId)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Html.DisplayFor(model => model.Status)</span>
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TotalPrice)
            </dt>
            <dd class="col-sm-9 text-primary fw-bold">
                $@Html.DisplayFor(model => model.TotalPrice)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.OrderDate)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.OrderDate)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ShipperDate)
            </dt>
            <dd class="col-sm-9">
                @(Model.ShipperDate.HasValue ? Model.ShipperDate.Value.ToString("yyyy/MM/dd HH:mm") : "-")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.GroupShipperId)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.GroupShipperId)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PickupMethod)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PickupMethod)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ShipName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ShipName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ShipAddress)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ShipAddress)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ShipPhone)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ShipPhone)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Freight)
            </dt>
            <dd class="col-sm-9">
                $@Html.DisplayFor(model => model.Freight)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PaymentMethodId)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PaymentMethodId)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <!-- 修正重點：移除自訂 name="grouporderid"，讓 asp-for 正確匹配後端 id -->
    <input type="hidden" asp-for="GroupOrderId" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>