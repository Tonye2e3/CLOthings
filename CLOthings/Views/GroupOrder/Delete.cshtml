@model CLOthings.Models.GroupOrder

@{
    ViewData["Title"] = "刪除訂單";
}

<h1>刪除訂單</h1>

<div class="alert alert-danger" role="alert">
    <strong>警告！</strong> 您確定要刪除這筆團購訂單嗎？此操作無法復原。
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">團購訂單資料 (#@Model.GroupOrderId)</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">訂單編號</dt>
            <dd class="col-sm-9">#@Html.DisplayFor(model => model.GroupOrderId)</dd>

            <dt class="col-sm-3">會員編號</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UserId)</dd>

            <dt class="col-sm-3">訂單狀態</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Html.DisplayFor(model => model.Status)</span>
            </dd>

            <dt class="col-sm-3">總金額</dt>
            <dd class="col-sm-9 text-primary fw-bold">
                $@Html.DisplayFor(model => model.TotalPrice)
            </dd>

            <dt class="col-sm-3">訂單日期</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.OrderDate)</dd>

            <dt class="col-sm-3">出貨日期</dt>
            <dd class="col-sm-9">
                @(Model.ShipperDate.HasValue ? Model.ShipperDate.Value.ToString("yyyy/MM/dd HH:mm") : "-")
            </dd>

            <dt class="col-sm-3">物流商編號</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.GroupShipperId)</dd>

            <dt class="col-sm-3">取貨方式</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PickupMethod)</dd>

            <dt class="col-sm-3">收件人姓名</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipName)</dd>

            <dt class="col-sm-3">收件地址</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipAddress)</dd>

            <dt class="col-sm-3">收件人電話</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ShipPhone)</dd>

            <dt class="col-sm-3">運費</dt>
            <dd class="col-sm-9">$@Html.DisplayFor(model => model.Freight)</dd>

            <dt class="col-sm-3">付款方式編號</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PaymentMethodId)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="GroupOrderId" />
    <input type="submit" value="確認刪除" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-secondary">返回列表</a>
</form>