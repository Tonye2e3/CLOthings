@model CLOthings.Models.GroupOrder

@{
    ViewData["Title"] = "新增團購訂單";
}

<h1>新增訂單</h1>
<h4>團購訂單資訊</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- 隱藏會員編號輸入框，系統自動帶入 UserId -->
            <input type="hidden" asp-for="UserId" />

            <!-- ➕ 新增選擇商品區塊 -->
            <div class="form-group mb-3">
                <label class="control-label fw-bold text-primary">選擇訂購商品</label>
                <select name="productId" class="form-select" asp-items="ViewBag.GroupProductId" required>
                    <option value="">-- 請選擇商品 --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold text-primary">商品數量</label>
                <input name="quantity" class="form-control" type="number" min="1" value="1" required />
            </div>
            <!-- --------------------- -->

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">訂單狀態</label>
                <select asp-for="Status" class="form-select">
                    <option value="處理中">處理中</option>
                    <option value="已付款">已付款</option>
                    <option value="出貨中">出貨中</option>
                    <option value="已完成">已完成</option>
                    <option value="已取消">已取消</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TotalPrice" class="control-label">總金額</label>
                <input asp-for="TotalPrice" class="form-control" type="number" step="0.01" value="" placeholder="請輸入金額" />
                <span asp-validation-for="TotalPrice" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OrderDate" class="control-label">訂單日期</label>
                <input asp-for="OrderDate" id="OrderDate" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="OrderDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShipperDate" class="control-label">預計/實際出貨日期</label>
                <input asp-for="ShipperDate" id="ShipperDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="ShipperDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="GroupShipperId" class="control-label">物流商編號</label>
                <input asp-for="GroupShipperId" class="form-control" />
                <span asp-validation-for="GroupShipperId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PickupMethod" class="control-label">取貨方式</label>
                <select asp-for="PickupMethod" class="form-select">
                    <option value="宅配到府">宅配到府</option>
                    <option value="超商取貨">超商取貨</option>
                </select>
                <span asp-validation-for="PickupMethod" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShipName" class="control-label">收件人姓名</label>
                <input asp-for="ShipName" class="form-control" />
                <span asp-validation-for="ShipName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShipAddress" class="control-label">收件地址</label>
                <input asp-for="ShipAddress" class="form-control" />
                <span asp-validation-for="ShipAddress" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ShipPhone" class="control-label">收件人電話</label>
                <input asp-for="ShipPhone" class="form-control" />
                <span asp-validation-for="ShipPhone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Freight" class="control-label">運費</label>
                <input asp-for="Freight" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Freight" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PaymentMethodId" class="control-label">付款方式</label>
                <select asp-for="PaymentMethodId" class="form-select" asp-items="ViewBag.PaymentMethodId">
                    <option value="">-- 請選擇付款方式 --</option>
                </select>
                <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
            </div>

            <div class="form-group mt-4 mb-5">
                <input type="submit" value="建立訂單" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const orderDateInput = document.getElementById("OrderDate");
            const shipperDateInput = document.getElementById("ShipperDate");

            function updateShipperDateMin() {
                if (orderDateInput.value) {
                    shipperDateInput.min = orderDateInput.value;
                    if (shipperDateInput.value && shipperDateInput.value < orderDateInput.value) {
                        shipperDateInput.value = orderDateInput.value;
                    }
                }
            }

            updateShipperDateMin();
            orderDateInput.addEventListener("change", updateShipperDateMin);
        });
    </script>
}