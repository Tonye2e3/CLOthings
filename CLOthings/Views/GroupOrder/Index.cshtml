@model IEnumerable<CLOthings.Models.GroupOrder>

@{
    ViewData["Title"] = "團購訂單列表";
}

<div class="d-flex justify-content-between align-items-center my-3">
    <h1>團購訂單管理</h1>
    <a asp-action="Create" class="btn btn-primary">➕ 新增訂單</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>訂單編號</th>
                <th>會員編號</th>
                <th>訂購產品</th>
                <th>訂單狀態</th>
                <th>總金額</th>
                <th>訂單日期</th>
                <th>取貨方式</th>
                <th>收件人姓名</th>
                <th class="text-center" style="width: 180px;">操作區塊</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        目前尚無訂單資料。
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@Html.DisplayFor(modelItem => item.GroupOrderId)</td>
                        <td>@Html.DisplayFor(modelItem => item.UserId)</td>

                        <!-- 訂購產品欄位（已移除後方的數量字串） -->
                        <td>
                            @if (item.GroupOrderDetails != null && item.GroupOrderDetails.Any())
                            {
                                foreach (var detail in item.GroupOrderDetails)
                                {
                                    <div>
                                        @if (detail.GroupProduct != null)
                                        {
                                            <span>@detail.GroupProduct.ProductName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">產品編號: @detail.GroupProductId</span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">無產品資料</span>
                            }
                        </td>

                        <!-- 訂單狀態標籤 -->
                        <td>
                            @switch (item.Status)
                            {
                                case "已完成":
                                    <span class="badge bg-success">已完成</span>
                                    break;
                                case "處理中":
                                    <span class="badge bg-warning text-dark">處理中</span>
                                    break;
                                case "已付款":
                                    <span class="badge bg-info text-dark">已付款</span>
                                    break;
                                case "出貨中":
                                case "已出貨":
                                    <span class="badge bg-primary">@item.Status</span>
                                    break;
                                case "已取消":
                                case "流團取消":
                                    <span class="badge bg-danger">@item.Status</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>

                        <td class="fw-bold text-primary">
                            $@item.TotalPrice.ToString("N0")
                        </td>
                        <td>
                            @item.OrderDate.ToString("yyyy/MM/dd HH:mm")
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.PickupMethod)</td>
                        <td>@Html.DisplayFor(modelItem => item.ShipName)</td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.GroupOrderId" class="btn btn-outline-warning">編輯</a>
                                <a asp-action="Details" asp-route-id="@item.GroupOrderId" class="btn btn-outline-info">詳情</a>
                                <a asp-action="Delete" asp-route-id="@item.GroupOrderId" class="btn btn-outline-danger">刪除</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>