@model IEnumerable<CLOthings.Models.GroupOrder>

@{
    ViewData["Title"] = "團購訂單列表";
}

<div class="d-flex justify-content-between align-items-center my-3">
    <h1>團購訂單列表 (Group Orders)</h1>
    <a asp-action="Create" class="btn btn-primary">➕ 新增訂單</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.GroupOrderId)</th>
                <th>@Html.DisplayNameFor(model => model.UserId)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th>@Html.DisplayNameFor(model => model.TotalPrice)</th>
                <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                <th>@Html.DisplayNameFor(model => model.PickupMethod)</th>
                <th>@Html.DisplayNameFor(model => model.ShipName)</th>
                <th class="text-center" style="width: 180px;">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        目前尚無訂單資料。
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@Html.DisplayFor(modelItem => item.GroupOrderId)</td>
                        <td>@Html.DisplayFor(modelItem => item.UserId)</td>
                        <td>
                            @switch (item.Status)
                            {
                                case "已完成":
                                    <span class="badge bg-success">已完成</span>
                                    break;
                                case "處理中":
                                    <span class="badge bg-warning text-dark">處理中</span>
                                    break;
                                case "已出貨":
                                case "出貨中":
                                    <span class="badge bg-info text-dark">@item.Status</span>
                                    break;
                                case "已取消":
                                    <span class="badge bg-danger">已取消</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="fw-bold text-primary">
                            $@item.TotalPrice.ToString("N0")
                        </td>
                        <td>
                            @item.OrderDate.ToString("yyyy/MM/dd HH:mm")
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.PickupMethod)</td>
                        <td>@Html.DisplayFor(modelItem => item.ShipName)</td>
                        <td class="text-center">
                            <!-- 修正重點：asp-route-id -->
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.GroupOrderId" class="btn btn-outline-warning">編輯</a>
                                <a asp-action="Details" asp-route-id="@item.GroupOrderId" class="btn btn-outline-info">明細</a>
                                <a asp-action="Delete" asp-route-id="@item.GroupOrderId" class="btn btn-outline-danger">刪除</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>