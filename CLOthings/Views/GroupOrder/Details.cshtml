@model CLOthings.Models.GroupOrder

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">基本資訊</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.GroupOrderId)</dt>
                    <dd class="col-sm-8">#@Html.DisplayFor(model => model.GroupOrderId)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UserId)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.UserId)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == "已完成")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else if (Model.Status == "處理中")
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }
                        else if (Model.Status == "已取消")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderDate)</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("yyyy/MM/dd HH:mm")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PaymentMethodId)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PaymentMethodId)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">物流與收件資訊</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ShipName)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ShipName)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ShipPhone)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.ShipPhone)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PickupMethod)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.PickupMethod)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ShipAddress)</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.ShipAddress) ? "-" : Model.ShipAddress)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ShipperDate)</dt>
                    <dd class="col-sm-8">@(Model.ShipperDate.HasValue ? Model.ShipperDate.Value.ToString("yyyy/MM/dd HH:mm") : "-")</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.GroupShipperId)</dt>
                    <dd class="col-sm-8">@(Model.GroupShipperId.HasValue ? Model.GroupShipperId.ToString() : "-")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-primary">
            <div class="card-body d-flex justify-content-around align-items-center text-center py-3">
                <div>
                    <div class="text-muted small">@Html.DisplayNameFor(model => model.Freight)</div>
                    <div class="fs-5 fw-bold">$@Model.Freight.ToString("N0")</div>
                </div>
                <div class="vr"></div>
                <div>
                    <div class="text-muted small">@Html.DisplayNameFor(model => model.TotalPrice)</div>
                    <div class="fs-3 fw-bold text-primary">$@Model.TotalPrice.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <!-- 修正重點：asp-route-id -->
    <a asp-action="Edit" asp-route-id="@Model?.GroupOrderId" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>