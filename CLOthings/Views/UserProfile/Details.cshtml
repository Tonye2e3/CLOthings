@model CLOthings.Models.UserProfile

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">使用者資料</h1>

<table class="table table-bordered table-striped" style="width: 60%;">
    <tbody>
        <tr>
            <th style="width: 30%;">@Html.DisplayNameFor(m => m.UserId)</th>
            <td>@Html.DisplayFor(m => m.UserId)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.FirstName)</th>
            <td>@Html.DisplayFor(m => m.FirstName)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.LastName)</th>
            <td>@Html.DisplayFor(m => m.LastName)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Avatar)</th>
            <td>
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" alt="頭像" style="width:100px;height:100px;border-radius:50%;" />
                }
                else
                {
                    <span class="text-muted">尚未上傳</span>
                }
            </td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Gender)</th>
            <td>@Html.DisplayFor(m => m.Gender)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Birthday)</th>
            <td>@Html.DisplayFor(m => m.Birthday)</td>
        </tr>
        <tr>
            <th>@Html.DisplayNameFor(m => m.User)</th>
            <td>@Html.DisplayFor(m => m.User)</td>
        </tr>
    </tbody>
</table>

<div class="mt-3">
    <a class="btn btn-secondary" asp-action="Edit" asp-route-UserProfileId="@Model?.UserProfileId">編輯</a>
</div>
