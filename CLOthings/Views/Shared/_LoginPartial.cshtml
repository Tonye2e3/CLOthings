


<ul class="navbar-nav">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- 登入後顯示 -->
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="UserProfile" asp-action="Profile">
                Hi, @User.Identity.Name
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="User" asp-action="Logout">登出</a>
        </li>
}
else
{
        <!-- 未登入顯示 -->
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="User" asp-action="Login">登入</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="User" asp-action="Register">註冊</a>
        </li>
}
</ul>
