@model CLOthings.Models.CommunityPost

@{
    ViewData["Title"] = "貼文詳細資訊";
}

<!-- 引入 ElaAdmin 主要 CSS 樣式檔 -->

<!-- 套用 ElaAdmin 標準動畫與格線容器 -->
<div class="animated fadeIn mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- 頂部標題列與操作按鈕 -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold">📌 貼文詳情</h3>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.CommunityPostId" class="btn btn-warning me-1">✏️ 編輯/審核貼文</a>
                    <a asp-action="Index" class="btn btn-secondary">返回列表</a>
                </div>
            </div>

            <!-- 卡片 1：貼文核心內容與發布者資訊 -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <strong class="card-title mb-0">📌 貼文主體內容</strong>
                    <span class="badge bg-light text-dark fs-6">貼文編號: @Model.CommunityPostId</span>
                </div>
                <div class="card-body">
                    <!-- 發布資訊與狀態摘要列 -->
                    <div class="row mb-4 p-3 bg-light rounded border g-3">
                        <div class="col-md-4">
                            <strong class="text-muted d-block mb-1">發布使用者</strong>
                            <span class="fs-6 text-primary fw-bold">👤 @(Model.User?.Username ?? Model.UserId.ToString())</span>
                        </div>
                        <div class="col-md-4">
                            <strong class="text-muted d-block mb-1">發布時間</strong>
                            <span class="fs-6">🕒 @Model.PostDate.ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                        <div class="col-md-4">
                            <strong class="text-muted d-block mb-1">顯示狀態</strong>
                            @if (Model.Status?.ToLower() == "public")
                            {
                                <span class="badge bg-success fs-6">公開</span>
                            }
                            else if (Model.Status?.ToLower() == "check")
                            {
                                <span class="badge bg-warning text-dark fs-6">待審核</span>
                            }
                            else if (Model.Status?.ToLower() == "hidden")
                            {
                                <span class="badge bg-danger fs-6">隱藏</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark fs-6">@(Model.Status ?? "未設定")</span>
                            }
                        </div>
                    </div>

                    <!-- 貼文內文 -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-secondary mb-2">💬 貼文內容：</h5>
                        <div class="p-3 bg-white rounded border fs-6 text-break shadow-sm" style="white-space: pre-line; min-height: 80px; line-height: 1.6;">
                            @Model.Content
                        </div>
                    </div>

                    <!-- 貼文圖片展示區 -->
                    <div class="mb-2">
                        <h5 class="fw-bold text-secondary mb-2">🖼️ 貼文圖片：</h5>
                        @if (Model.PostImages != null && Model.PostImages.Any())
                        {
                            <div class="d-flex flex-wrap gap-3 mt-2">
                                @foreach (var img in Model.PostImages)
                                {
                                    <a href="@img.ImageFileName" target="_blank" title="點擊查看原圖">
                                        <img src="@img.ImageFileName" class="img-thumbnail rounded border shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" alt="貼文照片" />
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">（此貼文無圖片）</p>
                        }
                    </div>
                </div>
            </div>

            <!-- 卡片 2：標籤商品展示區 -->
            <div class="card border-info shadow-sm mb-4">
                <div class="card-header bg-info text-white fw-bold py-3">
                    <strong class="card-title mb-0">🏷️ 標籤商品</strong>
                </div>
                <div class="card-body">
                    @if (Model.PostTaggedProducts != null && Model.PostTaggedProducts.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in Model.PostTaggedProducts)
                            {
                                if (tag.Product != null)
                                {
                                    <span class="badge bg-light text-dark border p-2 fs-6">
                                        🛍️ @tag.Product.ProductName
                                    </span>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 fst-italic">（未標籤任何商品）</p>
                    }
                </div>
            </div>

            <!-- 卡片 3：貼文留言管理區 -->
            <div class="card border-secondary shadow-sm mb-4">
                <div class="card-header bg-dark text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <strong class="card-title mb-0">💬 貼文留言管理</strong>
                    <span class="badge bg-secondary fs-6">共 @(Model.PostComments?.Count ?? 0) 則</span>
                </div>
                <div class="card-body">
                    @if (Model.PostComments != null && Model.PostComments.Any())
                    {
                        <div class="list-group">
                            @foreach (var comment in Model.PostComments)
                            {
                                <div class="list-group-item list-group-item-action p-3 mb-2 rounded border">
                                    <div class="d-flex w-100 justify-content-between align-items-center border-bottom pb-2 mb-2">
                                        <h6 class="mb-0 text-primary fw-bold">
                                            👤 @(comment.User?.Username ?? $"使用者 ID: {comment.UserId}")
                                        </h6>
                                        <div class="d-flex align-items-center gap-3">
                                            <small class="text-muted">🕒 @comment.CommentDate.ToString("yyyy/MM/dd HH:mm")</small>

                                            <!-- 刪除違規留言按鈕 -->
                                            <form asp-action="DeleteComment" method="post" onsubmit="return confirm('確定要刪除這筆違規留言嗎？');" style="display:inline;">
                                                <input type="hidden" name="commentId" value="@comment.PostCommentId" />
                                                <input type="hidden" name="postId" value="@Model.CommunityPostId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2">
                                                    🗑️ 刪除留言
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <p class="mb-0 text-dark fs-6 text-break">@comment.CommentText</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 fst-italic">（目前尚無留言）</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>