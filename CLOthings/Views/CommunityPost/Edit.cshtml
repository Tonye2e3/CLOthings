@model CLOthings.Models.CommunityPost

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CommunityPost</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!-- 隱藏主鍵 ID -->
            <input type="hidden" asp-for="CommunityPostId" />
            
            <!-- 1. 發文者 ID (可留作紀錄或隱藏) -->
            <div class="form-group mb-3">
                <label asp-for="UserId" class="control-label">發文者</label>
                <input asp-for="UserId" class="form-control" readonly />
            </div>

            <!-- 2. 貼文內容 -->
            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label">貼文內容</label>
                <textarea asp-for="Content" class="form-control" rows="3"></textarea>                
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- 3. 發佈日期 -->
            <div class="form-group mb-3">
                <label asp-for="PostDate" class="control-label">發佈日期</label>
                <input asp-for="PostDate" class="form-control" readonly />
            </div>

            <!-- 4. 文章狀態 (下拉選單) -->
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">文章狀態</label>
                <select asp-for="Status" class="form-control">
                    <option value="public">public (公開)</option>
                    <option value="hidden">hidden (隱藏)</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            
            <!-- 5. 目前圖片與新圖片上傳 -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">目前貼文照片（勾選即可刪除）</label>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    @if (Model.PostImages != null && Model.PostImages.Any())
                        {
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var img in Model.PostImages)
                                {
                                    <div class="card p-2 text-center" style="width: 110px;">
                                        <img src="@img.ImageFileName" class="img-thumbnail mb-2" style="height: 90px; object-fit: cover;" />
                                        <div class="form-check d-flex justify-content-center gap-1 p-0">
                                            <input type="checkbox" name="deleteImageIds" value="@img.PostImageId" class="form-check-input" id="img_@img.PostImageId" />
                                            <label class="form-check-label text-danger fw-bold" for="img_@img.PostImageId" style="font-size: 12px; cursor: pointer;">刪除</label>
                                        </div>
                                    </div>
                                }
                            </div>
                    }
                    else
                    {
                        <span class="text-muted">目前無圖片</span>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">新增/上傳圖片（若不修改請留空）</label>
                    <!-- 2. 加上 multiple 即可開啟多選功能 -->
                    <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" />
                    <!-- 新增下面這行提示文字 -->
                    <small class="text-muted d-block mt-1">
                        💡 提示：按住鍵盤 <kbd>Ctrl</kbd> 鍵可一次勾選多張圖片
                    </small>
                </div>
            </div>
            
            <!-- 6. 標籤商品 (Checkbox) -->
            <div class="form-group mb-3">
                <label class="control-label d-block">標籤商品</label>
                @if (ViewBag.ProductList != null)
                {
                    // 拿到這篇貼文目前已經勾選的 ProductId 清單
                    var selectedIds = Model.PostTaggedProducts?.Select(p => p.ProductId).ToList() ?? new List<int>();

                    foreach (var product in ViewBag.ProductList)
                    {
                        bool isChecked = selectedIds.Contains(product.ProductId);
                         <div class="form-check form-check-inline me-3">
                               <input class="form-check-input" type="checkbox" name="selectedProductIds" value="@product.ProductId" id="prod_@product.ProductId" @(isChecked ? "checked" : "")>
                               <label class="form-check-label" for="prod_@product.ProductId">
                                   @product.ProductName
                               </label>
                         </div>
                     }
                }
                else
                {
                    <span class="text-muted">無商品可選擇</span>
                }
              
            </div>
            
            <button type="submit" class="btn btn-primary mt-2">Save</button>         
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
