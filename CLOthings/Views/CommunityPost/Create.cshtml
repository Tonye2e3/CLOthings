@model CLOthings.Models.CommunityPost

@{
    ViewData["Title"] = "新增官方貼文";
}

<!-- 套用 ElaAdmin 標準動畫與格線容器 -->
<div class="animated fadeIn mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- 頂部標題列 -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold">📢 新增官方貼文 / 公告</h3>
                <span class="badge bg-primary fs-6">後台管理員功能</span>
            </div>

            <!-- ElaAdmin 卡片結構區塊 -->
            <div class="card border-primary shadow-sm mb-4">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <strong class="card-title mb-0">✍️ 貼文內容設定</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. 發布帳號 (鎖定為管理員，唯讀) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">發布帳號</label>
                            <!-- 顯示用的唯讀欄位，加 ?? 防呆 -->
                            <input type="text"
                                   class="form-control bg-light"
                                   value="@(ViewBag.AdminUserName ?? "superAdmin (官方管理員)")"
                                   readonly />

                            <!-- 實際回傳給 Controller 的 UserId 隱藏欄位 -->
                            <input type="hidden" asp-for="UserId" value="@(ViewBag.AdminUserId ?? 17)" />

                            <div class="form-text text-muted mt-1">後台新增之貼文將統一以官方管理員身份發布。</div>
                        </div>

                        <!-- 2. 貼文內容 (改成多行文字框 textarea 體驗更好) -->
                        <div class="mb-4">
                            <label asp-for="Content" class="form-label fw-bold">內容</label>
                            <textarea asp-for="Content" class="form-control" rows="4" placeholder="請輸入官方公告或貼文內文..."></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <!-- 3. 文章狀態 -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold">文章狀態</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Public">公開</option>
                                <option value="Hidden">隱藏</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- 4. 上傳圖片 -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">上傳貼文照片（可複選）</label>
                            <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" />
                            <div class="form-text text-muted mt-1">💡 提示：可按住 <kbd>Ctrl</kbd> 或 <kbd>Shift</kbd> 鍵一次選取多張圖片。</div>
                        </div>

                        <!-- 5. 標籤商品 -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">標籤商品</label>
                            <div class="p-3 border rounded bg-light" style="max-height: 180px; overflow-y: auto;">
                                <div class="row g-2">
                                    @if (ViewBag.Products != null)
                                    {
                                        foreach (var product in ViewBag.Products)
                                        {
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="selectedProductIds" value="@product.ProductId" id="prod_@product.ProductId">
                                                    <label class="form-check-label" for="prod_@product.ProductId">
                                                        @product.ProductName
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">（無可選商品）</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 按鈕區 -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">🚀 發布貼文</button>
                            <a asp-action="Index" class="btn btn-secondary">返回列表</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}