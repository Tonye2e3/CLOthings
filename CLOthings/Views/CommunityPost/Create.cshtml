@model CLOthings.Models.CommunityPost

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CommunityPost</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- 1. 選擇發文者測試 -->
            <div class="form-group mb-3">
                <label class="control-label">發文者 (測試用)</label>
                <select asp-for="UserId" class="form-control">
                    @if (ViewBag.Users != null)
                    {
                        foreach (var user in ViewBag.Users)
                        {
                            // 假設 User 模型裡有 UserId 與 UserName/Name 欄位
                            <option value="@user.UserId">@user.UserId - @user.Username</option>
                        }
                    }
                </select>
            </div>
            <!-- 2. 貼文內容 -->
            <div class="form-group">
                <label asp-for="Content" class="control-label">內容</label>
                <input asp-for="Content" class="form-control" />
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- 3. 文章狀態 (下拉選單) -->
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label">文章狀態</label>
                <select asp-for="Status" class="form-control">
                    <option value="Public">公開</option>
                    <option value="Hidden">隱藏</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            

            <!-- 4. 上傳圖片 (PostImages) -->
            <div class="form-group mb-3">
                <label class="control-label">上傳貼文照片（可複選）</label>
                <input type="file" name="imageFiles" class="form-control" multiple accept="image/*" />
            </div>

            <!-- 5. 標籤商品 (PostTaggedProducts) -->
            <div class="form-group mb-3">
                <label class="control-label d-block">標籤商品</label>
                @if (ViewBag.Products != null)
                {
                    foreach (var product in ViewBag.Products)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="selectedProductIds" value="@product.ProductId" id="prod_@product.ProductId">
                            <label class="form-check-label" for="prod_@product.ProductId">
                                @product.ProductName
                            </label>
                        </div>
                    }
                }
            </div>

            
            <button type="submit" class="btn btn-primary mt-2">發布貼文</button>
            
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
