@model IEnumerable<CLOthings.Models.CommunityPost>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PostDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <!-- 貼文圖片表頭 -->
            <th>
                貼文圖片
            </th>
            <!-- 標籤商品表頭 -->
            <th>
                標籤商品
            </th>
            <th>動作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.UserId)
                </td>
                <td style="max-width: 300px;">
                    @Html.DisplayFor(model => item.Content)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PostDate)
                </td>
                <td>
                    <span class="badge @(item.Status?.ToLower() == "public" ? "bg-success" : "bg-secondary")">
                        @item.Status?.ToLower()
                    </span>
                </td>

                <!-- 1. 呈現圖片 -->
                <td>
                    @if (item.PostImages != null && item.PostImages.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var img in item.PostImages)
                            {
                                <img src="@img.ImageFileName"
                                     alt="貼文圖片"
                                     class="img-thumbnail"
                                     style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">無圖片</span>
                    }
                </td>

                <!-- 2. 呈現標籤商品 (如果有 Include 抓資料的話) -->
                <td>
                    @if (item.PostTaggedProducts != null && item.PostTaggedProducts.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var tag in item.PostTaggedProducts)
                            {
                                <li>
                                    <span class="badge bg-info text-dark">
                                        @(tag.Product != null ? tag.Product.ProductName : $"商品 ID: {tag.ProductId}")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted small">無標籤</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.CommunityPostId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CommunityPostId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CommunityPostId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- 在表格下方顯示總筆數 -->
<div class="mt-3 text-end text-muted fw-bold">
    共 @Model.Count() 筆貼文
</div>