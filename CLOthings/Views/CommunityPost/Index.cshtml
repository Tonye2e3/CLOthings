@model IEnumerable<CLOthings.Models.CommunityPost>

@{
    ViewData["Title"] = "社群貼文管理";
}

<h1>社群貼文管理</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕新增官方貼文</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th style="white-space: nowrap;">
                發布者ID
            </th>
            <th style="white-space: nowrap;">
                貼文內容
            </th>
            <th style="white-space: nowrap;">
                發布時間
            </th>
            <th style="white-space: nowrap;">
                狀態
            </th>
            <!-- 貼文圖片表頭 -->
            <th style="white-space: nowrap;">
                貼文圖片
            </th>
            <!-- 按讚數表頭 -->
            <th style="white-space: nowrap;">
                按讚數
            </th>
            <!-- 留言數表頭 -->
            <th style="white-space: nowrap;">
                留言數
            </th>
            <!-- 標籤商品表頭 -->
            <th style="white-space: nowrap;">
                標籤商品
            </th>
            <th style ="white-space: nowrap;">操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.UserId)
                </td>
                <td style="max-width: 300px;">
                    @Html.DisplayFor(model => item.Content)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PostDate)
                </td>
                <td>
                    @if (item.Status?.ToLower() == "public")
                    {
                        <span class="badge bg-success">公開</span>
                    }
                    else if (item.Status?.ToLower() == "check")
                    {
                        <span class="badge bg-warning text-dark">待審核</span>
                    }
                    else if (item.Status?.ToLower() == "hidden")
                    {
                        <span class="badge bg-secondary">隱藏</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">@(item.Status ?? "未設定")</span>
                    }
                </td>

                <!-- 1. 呈現圖片 -->
                <td>
                    @if (item.PostImages != null && item.PostImages.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var img in item.PostImages)
                            {
                                <img src="@img.ImageFileName"
                                     alt="貼文圖片"
                                     class="img-thumbnail"
                                     style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">無圖片</span>
                    }
                </td>
                <!-- 2. 呈現按讚數 -->
                <td>
                    ❤️ @(item.PostLikes != null ? item.PostLikes.Count : 0)
                </td>
                <!-- 3. 呈現留言數 -->
                <td>
                    💬 @(item.PostComments != null ? item.PostComments.Count : 0)
                </td>

                <!-- 4. 呈現標籤商品 (如果有 Include 抓資料的話) -->
                <td>
                    @if (item.PostTaggedProducts != null && item.PostTaggedProducts.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var tag in item.PostTaggedProducts)
                            {
                                <li>
                                    <span class="badge bg-info text-dark">
                                        @(tag.Product != null ? tag.Product.ProductName : $"商品 ID: {tag.ProductId}")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted small">無標籤</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.CommunityPostId" class="btn btn-sm btn-outline-warning">編輯</a>
                    <a asp-action="Details" asp-route-id="@item.CommunityPostId" class="btn btn-sm btn-outline-info">詳細</a>
                    <a asp-action="Delete" asp-route-id="@item.CommunityPostId" class="btn btn-sm btn-outline-danger">刪除</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- 分頁控制項 -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted">
        共 @ViewBag.TotalItems 筆貼文 (第 @ViewBag.CurrentPage / @ViewBag.TotalPages 頁)
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination mb-0">
                <!-- 上一頁 -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-page-link page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">上一頁</a>
                </li>

                <!-- 頁碼按鈕 -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }

                <!-- 下一頁 -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">下一頁</a>
                </li>
            </ul>
        </nav>
    }
</div>
<!-- 在表格下方顯示總筆數 -->
<div class="mt-3 text-end text-muted fw-bold">
    共 @Model.Count() 筆貼文
</div>