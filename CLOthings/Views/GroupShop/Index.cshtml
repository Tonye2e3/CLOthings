@model string

@switch (Model)
{
    case "已完成":
        <span class="badge bg-success">已完成</span>
        break;
    case "處理中":
        <span class="badge bg-warning text-dark">處理中</span>
        break;
    case "已出貨":
    case "出貨中":
        <span class="badge bg-info text-dark">@Model</span>
        break;
    case "已取消":
        <span class="badge bg-danger">已取消</span>
        break;
    default:
        <span class="badge bg-secondary">@Model</span>
        break;
}