@model CLOthings.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>CLOthings.Models.Product</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ProductName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductName)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SupplierId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SupplierId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ProductCategoryId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductCategoryId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SalesStartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SalesStartDate)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SalesEndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SalesEndDate)
        </dd>
    </dl>
    
</dl>
<dl class="row">
    <dt class="col-sm-2">
        商品圖片
    </dt>
    <dd class="col-sm-10">
        @if (Model.ExistingImages != null && Model.ExistingImages.Any())
        {
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var img in Model.ExistingImages)
                {
                    <img src="~/imgs/products/@img.ProductImgFile"
                         style="width:100px;height:100px;object-fit:cover;" class="border rounded" />
                }
            </div>
        }
        else
        {
            <span class="text-muted">尚未上傳圖片</span>
        }
    </dd>
</dl>
<dl class="row">
    <dt class="col-sm-2">
        商品規格
    </dt>
    <dd class="col-sm-10">
        @if (Model.ProductSpecifications != null && Model.ProductSpecifications.Any())
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>尺寸</th>
                        <th>顏色</th>
                        <th>庫存數量</th>
                        <th>在途庫存</th>
                        <th>再訂量</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var spec in Model.ProductSpecifications)
                    {
                        <tr>
                            <td>@spec.Size</td>
                            <td>@spec.Color</td>
                            <td>@spec.Inventory</td>
                            <td>@spec.UnitOnOrder</td>
                            <td>@spec.ReorderLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <span class="text-muted">尚未設定規格</span>
        }
    </dd>
</dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProductId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
