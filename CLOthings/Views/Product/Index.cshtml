@model IEnumerable<CLOthings.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "商品管理";
}

<h1>CLO.things商品管理</h1>

<p>
    <a asp-action="Create" class="button-74 me-1" role="button">新增商品</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                <p style="text-align: center;">管理</p>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductImg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SalesStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SalesEndDate)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-primary btn-sm me-1" style="width:80px;" >Edit</a> <br/>
                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-success btn-sm me-1" style="width:80px;">Details</a> <br />
                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-outline-danger btn-sm me-1" style="width:80px;">Delete</a> <br />
                </td>

                <td>
                    @if (!string.IsNullOrEmpty(item.CoverImgFile))
                    {
                        <img src="~/imgs/products/@item.CoverImgFile"" alt="@item.ProductName"
                             style="width:60px; height:60px; object-fit:cover;" />
                    }
                    else
                    {
                        <span class="text-muted">無圖片</span>
                    }
                </td>

            <td>
                @Html.DisplayFor(model => item.ProductName)
            </td>
           
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.SalesStartDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.SalesEndDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductImg)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductSpecifications)
            </td>

            
        </tr>
}
    </tbody>
</table>

@section Styles {
    <link rel="stylesheet" href="~/css/button.css" asp-append-version="true" />
}