@model CLOthings.ViewModels.ProductViewModel


@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="d-flex gap-2 flex-wrap">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SupplierId" class="control-label"></label>
                <select asp-for="SupplierId" asp-items="@ViewBag.SupplierOptions" class="form-control">
                    <option value="">--請選擇--</option>
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProductCategoryId" class="control-label"></label>
                <select asp-for="ProductCategoryId" asp-items="@ViewBag.CategoryOptions" class="form-control">
                    <option value="">--請選擇--</option>
                </select>
                <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" asp-items="@ViewBag.StatusOptions"  class="form-control">
                    <option value="">--請選擇--</option>
                </select> 
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SalesStartDate" class="control-label"></label>
                <input asp-for="SalesStartDate" class="form-control" />
                <span asp-validation-for="SalesStartDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SalesEndDate" class="control-label"></label>
                <input asp-for="SalesEndDate" class="form-control" />
                <span asp-validation-for="SalesEndDate" class="text-danger"></span>
            </div>

         

            <div class="form-group">
                <label asp-for="ProductImg" class="control-label"></label>
                <input type="file" id="fileInput" name="ProductImg" multiple accept="image/*" class="form-control" />
                <div id="previewContainer" class="d-flex gap-2 flex-wrap mt-2"></div>
                <span asp-validation-for="ProductImg" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">商品規格</label>

                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex gap-2 border rounded p-2 mb-2 flex-wrap">
                        <div style="flex: 1; min-width: 80px;">
                            <label class="small">尺寸</label>
                            <input name="ProductSpecifications[@i].Size" class="form-control form-control-sm" />
                        </div>
                        <div style="flex: 1; min-width: 80px;">
                            <label class="small">顏色</label>
                            <input name="ProductSpecifications[@i].Color" class="form-control form-control-sm" />
                        </div>
                        <div style="flex: 1; min-width: 80px;">
                            <label class="small">庫存數量</label>
                            <input name="ProductSpecifications[@i].Inventory" type="number" class="form-control form-control-sm" />
                        </div>
                        <div style="flex: 1; min-width: 80px;">
                            <label class="small">在途庫存</label>
                            <input name="ProductSpecifications[@i].UnitOnOrder" type="number" class="form-control form-control-sm" />
                        </div>
                        <div style="flex: 1; min-width: 80px;">
                            <label class="small">再訂量</label>
                            <input name="ProductSpecifications[@i].ReorderLevel" type="number" class="form-control form-control-sm" />
                        </div>
                    </div>
                }
            </div>

            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script>
    // 存放目前使用者實際選定要上傳的檔案（DataTransfer 用來動態增減 FileList）
    let dt = new DataTransfer();

    const fileInput = document.getElementById('fileInput');
    const previewContainer = document.getElementById('previewContainer');

    fileInput.addEventListener('change', function () {
        // 把這次新選的檔案，加進原本已經選好的清單裡
        for (const file of fileInput.files) {
            dt.items.add(file);
        }
        fileInput.files = dt.files; // 更新 input 實際的檔案清單（含之前選過的）
        renderPreview();
    });

    function renderPreview() {
        previewContainer.innerHTML = '';

        Array.from(dt.files).forEach((file, index) => {
            const url = URL.createObjectURL(file);

            const card = document.createElement('div');
            card.className = 'text-center border rounded p-2';
            card.style.width = '120px';
            card.innerHTML = `
                <img src="${url}" style="width:100px;height:100px;object-fit:cover;" />
                <div class="small mt-1 text-truncate">${file.name}</div>
                <button type="button" class="btn btn-outline-danger btn-sm mt-1 removeBtn" data-index="${index}">刪除</button>
            `;
            previewContainer.appendChild(card);
        });

        // 綁定每個刪除按鈕的事件
        document.querySelectorAll('.removeBtn').forEach(btn => {
            btn.addEventListener('click', function () {
                const index = parseInt(this.dataset.index);
                removeFile(index);
            });
        });
    }

    function removeFile(index) {
        const newDt = new DataTransfer();
        Array.from(dt.files).forEach((file, i) => {
            if (i !== index) {
                newDt.items.add(file);
            }
        });
        dt = newDt;
        fileInput.files = dt.files;
        renderPreview();
    }
</script>