@model CLOthings.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h1>登入</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Login" method="post" ass="mt-4" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div class="form-floating mb-3">
        <input asp-for="Account" class="form-control" placeholder="" />
        <label asp-for="Account">帳號</label>
        <span asp-validation-for="Account" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Password" class="form-control" placeholder="" />
        <label asp-for="Password">密碼</label>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="登入" class="btn btn-primary" />
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger">
        @Html.ValidationSummary()
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}