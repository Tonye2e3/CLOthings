@model CLOthings.Models.User
@{
    ViewData["Title"] = "Delete";
}

<h1>刪除</h1>
<h3>確定要刪除這個使用者嗎？</h3>
<div>
    <h4>使用者</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Username)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Username)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Account)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Phone)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.UserType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.UserType)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <!-- 1. 刪除鈕改成開啟 Modal 的按鈕 -->
    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
        刪除
    </button>
    |
    <a asp-action="Index">回列表</a>
</div>

<!-- 2. 彈跳視窗本體 -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">最終確認</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                你真的要刪除 <strong>@Model.Account (@Model.Username)</strong> 嗎？<br />
                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <!-- 真正送出刪除的表單放在這裡 -->
                <form asp-action="Delete" class="d-inline">
                    <input type="hidden" asp-for="UserId" />
                    <button type="submit" class="btn btn-danger">確定刪除</button>
                </form>
            </div>
        </div>
    </div>
</div>