@model CLOthings.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h1>註冊新帳號</h1>

<form asp-action="Register" method="post" class="mt-4" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div class="form-floating mb-3">
        <input asp-for="Username" class="form-control" placeholder="" />
        <label asp-for="Username">使用者名稱</label>
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Account" class="form-control" placeholder="" />
        <label asp-for="Account">帳戶名稱</label>
        <span asp-validation-for="Account" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" type="password" class="form-control" placeholder="" />
        <label asp-for="Password">密碼</label>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="" />
        <label asp-for="ConfirmPassword">確認密碼</label>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Email" type="email" class="form-control" placeholder="" />
        <label asp-for="Email">電子郵件</label>
        <span asp-validation-for="Email" class="text-danger"></span>

    </div>

    <div class="form-floating mb-3">
        <input asp-for="Phone" class="form-control" placeholder="" />
        <label asp-for="Phone">電話</label>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <input type="submit" value="註冊" class="btn btn-success" />
        <a class="btn btn-secondary" asp-action="Login">返回登入</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
